# Spotify — powers the Listening card on the shelf.
# Create an app at https://developer.spotify.com/dashboard, then add
# <your-site>/api/auth/callback as a redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Any long random string; encrypts the refresh-token cookie.
COOKIE_SECRET=

# Where /api/auth/callback sends you back to after authorizing.
FRONTEND_URL=http://localhost:3000

# Set this and every visitor sees YOUR listening data (not just you).
# To get it: restore app/api/auth/export-token from git, visit /api/auth/login,
# authorize, open /api/auth/export-token, copy refresh_token, then delete the route.
SPOTIFY_REFRESH_TOKEN=

# Optional. Production origin for sitemap / OG / canonical. Defaults to https://shivanipotnuru.com
# NEXT_PUBLIC_SITE_URL=https://shivanipotnuru.com

# The film shelf needs no keys — set LETTERBOXD_USERNAME in lib/data.ts.
